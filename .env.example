# =================================
# ejemplo o plantilla de las variables de entorno
# CONFIGURACIÓN DEL PROYECTo
# =================================

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=***REMOVED***
MYSQL_DATABASE=causas_judiciales_db
MYSQL_USER=admin_db
MYSQL_PASSWORD=password
MYSQL_MONITOR_USER=monitor_user
MYSQL_MONITOR_PASSWORD=***REMOVED***

MYSQL_REPLICATION_USER=***REMOVED***
MYSQL_REPLICATION_PASSWORD=***REMOVED***

# Redis
REDIS_PASSWORD=***REMOVED***

# JWT y Autenticación
JWT_SECRET=***REMOVED***
JWT_EXPIRE=24h

# API Gateway (Traefik)
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=***REMOVED***

# Frontend
REACT_APP_API_URL=http://localhost:8080/api

# Servicios Backend
AUTH_SERVICE_PORT=3001
CASOS_SERVICE_PORT=3002
DOCUMENTOS_SERVICE_PORT=3003
NOTIFICACIONES_SERVICE_PORT=3004
AI_SERVICE_PORT=3005

# Email (para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_password_de_aplicacion

# OpenAI (para servicio IA)
OPENAI_API_KEY=sk-tu-api-key-aqui

# Monitoreo
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=***REMOVED***

# Configuración de red
FRONTEND_NET_SUBNET=172.20.0.0/16
BACKEND_NET_SUBNET=172.21.0.0/16
DATABASE_NET_SUBNET=172.22.0.0/16
MONITORING_NET_SUBNET=172.23.0.0/16