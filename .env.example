# =================================
# Plantilla de variables de entorno (.env.example)
# CONFIGURACIÓN DEL PROYECTO
# =================================
# Copie este archivo a .env y reemplace todos los valores CHANGE_ME
# con secretos generados localmente (ej: openssl rand -hex 32).

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=causas_judiciales_db
MYSQL_USER=admin_db
MYSQL_PASSWORD=CHANGE_ME
MYSQL_MONITOR_USER=monitor_user
MYSQL_MONITOR_PASSWORD=CHANGE_ME

MYSQL_REPLICATION_USER=***REMOVED***
MYSQL_REPLICATION_PASSWORD=CHANGE_ME

# Contraseñas para usuarios de base de datos por rol
MYSQL_PASSWORD_ADMIN_APP=CHANGE_ME
MYSQL_PASSWORD_ABOGADO_APP=CHANGE_ME
MYSQL_PASSWORD_ASISTENTE_APP=CHANGE_ME
MYSQL_PASSWORD_SISTEMAS_APP=CHANGE_ME
MYSQL_PASSWORD_READONLY_APP=CHANGE_ME
MYSQL_PASSWORD_ORCHESTRATOR_APP=CHANGE_ME

# Database URLs para acceso basado en roles
DATABASE_URL=mysql+pymysql://admin_db:${MYSQL_PASSWORD}@db-proxy:6033/causas_judiciales_db
DATABASE_URL_ADMINISTRADOR=mysql+pymysql://administrador:${MYSQL_PASSWORD_ADMIN_APP}@db-proxy:6033/causas_judiciales_db
DATABASE_URL_ABOGADO=mysql+pymysql://abogado:${MYSQL_PASSWORD_ABOGADO_APP}@db-proxy:6033/causas_judiciales_db
DATABASE_URL_ASISTENTE=mysql+pymysql://asistente:${MYSQL_PASSWORD_ASISTENTE_APP}@db-proxy:6033/causas_judiciales_db
DATABASE_URL_SISTEMAS=mysql+pymysql://sistemas:${MYSQL_PASSWORD_SISTEMAS_APP}@db-proxy:6033/causas_judiciales_db

# Redis
REDIS_PASSWORD=CHANGE_ME
REDIS_MAX_MEMORY=256mb
REDIS_DATABASES=16

# JWT y Autenticación
JWT_SECRET=CHANGE_ME
JWT_EXPIRE=24h
CASOS_SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# API Gateway (Traefik)
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=CHANGE_ME

# Frontend
REACT_APP_API_URL=http://localhost:8080/api

# Servicios Backend
AUTH_SERVICE_PORT=3001
CASOS_SERVICE_PORT=3002
DOCUMENTOS_SERVICE_PORT=3003
NOTIFICACIONES_SERVICE_PORT=3004
AI_SERVICE_PORT=3005

# Email (para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=CHANGE_ME

# IA y Seguridad
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME

# Monitoreo
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Prometheus
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_EVALUATION_INTERVAL=15s

# ProxySQL
PROXYSQL_ADMIN_USER=admin
PROXYSQL_ADMIN_PASSWORD=CHANGE_ME
MYSQL_MASTER_HOST=db-master
MYSQL_SLAVE_HOST=db-slave

# Traefik
TRAEFIK_API_INSECURE=true
TRAEFIK_DASHBOARD_ENABLED=true
TRAEFIK_LOG_LEVEL=INFO

# Configuración de red
FRONTEND_NET_SUBNET=172.20.0.0/16
BACKEND_NET_SUBNET=172.21.0.0/16
DATABASE_NET_SUBNET=172.22.0.0/16
MONITORING_NET_SUBNET=172.23.0.0/16
